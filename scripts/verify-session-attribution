#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# ///
"""verify-session-attribution — end-to-end test for the session attribution chain.

Each cell exercises one (harness, mode) pair and asserts:
  [1] run reached status=done (one-shot) or answered two turns (interactive)
  [2] session.json exists, confidence=certain, plausible acquisition
  [3] recorded id matches the harness's own record on disk
  [4] client_sessions row exists in llmproxy postgres with expected client value
  [5] (sub-agent cells only) child row's parent_client_session_id resolves to root

DB path: ssh <VIBES_HOST> → ssh <LLMPROXY_HOST> → sudo docker exec <postgres> psql

Approximate cost per full run: ~$0.02–0.05 (haiku/mini models, trivial prompts).
"""

from __future__ import annotations

import argparse
import atexit
import csv
import io
import json
import os
import re
import shlex
import shutil
import signal
import sqlite3
import subprocess
import sys
import textwrap
import time
import uuid
from dataclasses import dataclass, field
from pathlib import Path
from typing import Optional

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

VIBES_HOST    = os.environ.get("VIBES_HOST",     "vibes")
LLMPROXY_HOST = os.environ.get("LLMPROXY_HOST",  "llmproxy")
POSTGRES_USER = os.environ.get("POSTGRES_USER",  "llmproxy")
POSTGRES_DB   = os.environ.get("POSTGRES_DB",    "llmproxy")

DB_POLL_TIMEOUT  = float(os.environ.get("DB_POLL_TIMEOUT", "15"))
DB_POLL_INTERVAL = 0.5
RUN_TIMEOUT      = float(os.environ.get("RUN_TIMEOUT", "120"))
STATUS_POLL_INTERVAL = 1.0
INTERACTIVE_FIRST_REPLY_TIMEOUT  = float(os.environ.get("INTERACTIVE_FIRST_REPLY_TIMEOUT", "90"))
INTERACTIVE_SECOND_REPLY_TIMEOUT = float(os.environ.get("INTERACTIVE_SECOND_REPLY_TIMEOUT", "180"))

STATE_ROOT = Path(os.environ.get("AGENT_RUN_STATE_DIR", "/tmp/agent-runs"))
LOG_ROOT   = Path(os.environ.get("AGENT_RUN_LOG_DIR",   "/var/tmp/agent-runs"))

# Cheap models, to keep the suite's cost near zero.
CLAUDE_MODEL   = os.environ.get("CLAUDE_MODEL",   "claude-haiku-4-5")
OPENCODE_MODEL = os.environ.get("OPENCODE_MODEL", "llmproxy-anthropic/claude-haiku-4.5")
CODEX_MODEL    = os.environ.get("CODEX_MODEL",    "gpt-5.4")
CODEX_PROVIDER = os.environ.get("CODEX_PROVIDER", "llmproxy")

TERMINAL_STATUSES = {"done", "failed", "launch_failed", "died", "killed"}

# Interactive turn tokens must be *synthesised* by the model: the answer never
# appears in the prompt, and the two tokens are disjoint so a turn-1 reply
# cannot satisfy turn-2's check.  Prompts stay short because the claude TUI
# steer buffer is a single line (empirically ~50 bytes).
TURN1_PROMPT = "What is 7 times 6?"
TURN1_TOKEN  = "42"
TURN2_PROMPT = "What is 3 times 9?"
TURN2_TOKEN  = "27"

SUBAGENT_PROMPTS = {
    "claude": ("Use the Task tool to spawn a sub-agent with the instruction: "
               "'Reply with exactly: SUBPONG'. Wait for it to finish."),
    "opencode": ("Spawn an explore sub-agent with the instruction: "
                 "'Reply with exactly: SUBPONG'. Wait for it to finish."),
    "codex": ("Spawn a sub-agent and have it reply with exactly: SUBPONG. "
              "Wait for the child to finish."),
}

# agent-run mints UUIDs or ses_… strings; validating before interpolation keeps
# a stray quote from becoming a psql syntax error reported as "no row".
_SESSION_ID_RE = re.compile(r"^[A-Za-z0-9_-]+$")

PASS = "PASS"
FAIL = "FAIL"
SKIP = "SKIP"

# Every run launched this invocation, so the signal/atexit handlers can reap
# runs whose cell never got to its own teardown.
_active_runs: set[str] = set()
_json_mode: bool = False


def _ensure_openai_key() -> None:
    """Set OPENAI_API_KEY from ~/.codex/auth.json if not already in the env."""
    if os.environ.get("OPENAI_API_KEY"):
        return
    try:
        data = json.loads((Path.home() / ".codex" / "auth.json").read_text())
    except (OSError, json.JSONDecodeError):
        return  # codex cell fails loudly at link1 if the key is really missing
    if data.get("OPENAI_API_KEY"):
        os.environ["OPENAI_API_KEY"] = data["OPENAI_API_KEY"]


_ensure_openai_key()


@dataclass
class CellResult:
    name: str
    verdict: str = FAIL
    session_id: Optional[str] = None
    links: dict = field(default_factory=dict)
    notes: list = field(default_factory=list)
    failure_link: Optional[str] = None
    failure_detail: Optional[str] = None

    def pass_(self, session_id: str, links: dict) -> None:
        self.verdict = PASS
        self.session_id = session_id
        self.links = links

    def skip(self, reason: str) -> None:
        self.verdict = SKIP
        self.notes.append(reason)

    def fail(self, link: str, detail: str) -> None:
        self.verdict = FAIL
        self.failure_link = link
        self.failure_detail = detail
        self.notes.append(f"FAIL [{link}]: {detail}")


# ---------------------------------------------------------------------------
# Process / run-state utilities
# ---------------------------------------------------------------------------

def _log(msg: str) -> None:
    print(msg, flush=True, file=sys.stderr if _json_mode else sys.stdout)


def _run(*cmd: str, check: bool = True, timeout: int = 30) -> subprocess.CompletedProcess:
    """Run a command.

    check=True is load-bearing for the DB path: a non-zero ssh/psql/docker exit
    must raise so a transport failure can never be mistaken for an empty result.
    """
    return subprocess.run(list(cmd), capture_output=True, text=True,
                          timeout=timeout, check=check)


def _agent_run_quiet(*args: str) -> None:
    """Best-effort `agent-run` subcommand used on teardown paths; never raises."""
    try:
        _run("agent-run", *args, timeout=30, check=False)
    except Exception:
        pass


def _agent_run_status(name: str) -> str:
    try:
        return (STATE_ROOT / name / "status").read_text().strip()
    except OSError:
        return "unknown"


def _wait_for_terminal(name: str, timeout: float) -> str:
    """Poll until status is terminal or timeout. Returns the final status."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        st = _agent_run_status(name)
        if st in TERMINAL_STATUSES:
            return st
        time.sleep(STATUS_POLL_INTERVAL)
    return _agent_run_status(name)


def _session_json(run_name: str) -> Optional[dict]:
    try:
        data = json.loads((LOG_ROOT / run_name / "session.json").read_text(errors="replace"))
    except (OSError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def _read_log(run_name: str) -> str:
    """Whole run log — never a tail, so a token cannot scroll out of view."""
    try:
        return (LOG_ROOT / run_name / "log").read_bytes().decode("utf-8", errors="replace")
    except OSError:
        return ""


def _log_tail(run_name: str, max_chars: int = 1000) -> str:
    return _read_log(run_name)[-max_chars:]


def _count_in_log(run_name: str, token: str) -> int:
    return _read_log(run_name).lower().count(token.lower())


def _count_in_assistant_region(run_name: str, token: str) -> int:
    """Occurrences of token outside the echoed input lines of `agent-run clean`.

    The interactive log is a raw PTY capture, so the prompt is echoed into it and
    ANSI sequences (ESC[27m, cursor reports) contain bare digits; only the
    pyte-rendered transcript separates model output from input and control bytes.
    Claude prefixes user input with '❯', opencode with '┃'.
    """
    try:
        rendered = _run("agent-run", "clean", run_name, timeout=15, check=False)
        transcript = rendered.stdout if rendered.returncode == 0 else ""
    except Exception:
        return 0
    needle = token.lower()
    return sum(
        line.lower().count(needle)
        for line in (l.strip() for l in transcript.splitlines())
        if not line.startswith(("❯", "┃"))
    )


def _token_in_assistant_region(run_name: str, token: str) -> bool:
    """True if the model emitted token at least once outside the echoed input."""
    return _count_in_assistant_region(run_name, token) > 0


# ---------------------------------------------------------------------------
# Cleanup — must survive failure, launch timeout and SIGINT/SIGTERM
# ---------------------------------------------------------------------------

def _reap_run(name: str, keep: bool) -> None:
    _active_runs.discard(name)
    if keep:
        return
    # `agent-run reap` is the supported deletion path and refuses to delete a
    # live runner, turning a silent orphan into a loud error.  It also declines
    # runs younger than --min-age-hours, hence the rmtree fallback.
    _agent_run_quiet("reap", "--name", name, "--include-logs",
                     "--min-age-hours", "0.0001", "--log-min-age-hours", "0.0001",
                     "--idle-hours", "0.0001")
    for root in (STATE_ROOT, LOG_ROOT):
        if (root / name).is_dir():
            shutil.rmtree(root / name, ignore_errors=True)


def _kill_and_reap(name: str, keep: bool = False) -> None:
    """SIGTERM → wait → SIGKILL if still alive → reap. Never orphans a runner."""
    if not (STATE_ROOT / name).is_dir():
        _reap_run(name, keep)  # never launched, or already collected
        return
    _agent_run_quiet("kill", name)
    if _wait_for_terminal(name, 10) not in TERMINAL_STATUSES | {"unknown"}:
        _agent_run_quiet("kill", name, "KILL")
        _wait_for_terminal(name, 5)
    _reap_run(name, keep)


def _cleanup_all() -> None:
    for name in list(_active_runs):
        try:
            _kill_and_reap(name)
        except Exception:
            pass


def _install_signal_handlers() -> None:
    def _handler(signum, frame):
        _log(f"\n[verify] caught signal {signum}, cleaning up…")
        _cleanup_all()
        sys.exit(1)

    signal.signal(signal.SIGINT, _handler)
    signal.signal(signal.SIGTERM, _handler)
    atexit.register(_cleanup_all)


# ---------------------------------------------------------------------------
# DB access (two-hop SSH → psql)
# ---------------------------------------------------------------------------

@dataclass
class _DbError:
    """A transport/auth/query failure — never the same thing as "no rows"."""
    detail: str


def _psql_query_csv(sql: str) -> "list[dict] | _DbError":
    """Run a query via ssh vibes → ssh llmproxy → docker exec psql.

    The container id is discovered dynamically so restarts don't break us.
    """
    safe_sql = sql.replace("'", "'\"'\"'")
    inner_cmd = (
        f"sudo docker exec $(sudo docker ps -q -f name=llmproxy_postgres) "
        f"psql -U {POSTGRES_USER} -d {POSTGRES_DB} --csv -c '{safe_sql}'"
    )
    try:
        result = _run("ssh", VIBES_HOST, f"ssh {LLMPROXY_HOST} {shlex.quote(inner_cmd)}", timeout=20)
    except subprocess.SubprocessError as exc:
        _log(f"    [DB] query failed: {exc}")
        return _DbError(str(exc))
    return list(csv.DictReader(io.StringIO(result.stdout.strip())))


def _db_preflight() -> Optional[str]:
    """Return an error string if the DB path is not usable, else None."""
    rows = _psql_query_csv("SELECT 1 AS ok")
    if isinstance(rows, _DbError):
        return f"DB unreachable: {rows.detail}"
    if not rows or rows[0].get("ok") != "1":
        return "DB preflight returned unexpected result"
    return None


def _poll_db(column: str, session_id: str,
             timeout: float = DB_POLL_TIMEOUT) -> "dict | None | _DbError":
    """Poll client_sessions for a row where <column> = session_id.

    Returns dict (row found), None (timeout, no row) or _DbError (transport).
    """
    if not _SESSION_ID_RE.match(session_id):
        return _DbError(f"session_id {session_id!r} contains invalid characters")
    sql = (
        "SELECT client_session_id, client, parent_client_session_id, created_at "
        f"FROM client_sessions WHERE {column} = '{session_id}' LIMIT 1"
    )
    deadline = time.monotonic() + timeout
    last_error: Optional[_DbError] = None
    while time.monotonic() < deadline:
        rows = _psql_query_csv(sql)
        if isinstance(rows, _DbError):
            last_error = rows
        elif rows:
            return rows[0]
        time.sleep(DB_POLL_INTERVAL)
    return last_error


# ---------------------------------------------------------------------------
# Link 3 — the harness's own on-disk record (read-only)
# ---------------------------------------------------------------------------

def _verify_claude_disk(session_id: str, cwd: str) -> tuple[bool, str]:
    projects = Path.home() / ".claude" / "projects"
    expected = projects / cwd.replace("/", "-") / f"{session_id}.jsonl"
    if expected.exists():
        return True, str(expected)
    for found in projects.glob(f"*/{session_id}.jsonl"):
        return True, str(found)
    return False, f"no transcript at {expected} (scanned all project dirs)"


def _verify_opencode_disk(session_id: str) -> tuple[bool, str]:
    db_path = Path.home() / ".local" / "share" / "opencode" / "opencode.db"
    if not db_path.exists():
        return False, f"opencode.db not found at {db_path}"
    try:
        con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=5)  # never perturb the live WAL
        try:
            if not con.execute("SELECT id FROM session WHERE id = ? LIMIT 1", (session_id,)).fetchone():
                return False, f"no session row for id={session_id!r} in opencode.db"
            count = con.execute("SELECT COUNT(*) FROM message WHERE session_id = ?",
                                (session_id,)).fetchone()[0]
            if count == 0:
                return False, (f"session {session_id!r} exists in opencode.db but has 0 messages "
                               "(decoy empty session — FAIL)")
            return True, f"opencode.db: session has {count} message(s)"
        finally:
            con.close()
    except sqlite3.Error as exc:
        return False, f"sqlite error reading opencode.db: {exc}"


def _verify_codex_disk(session_id: str) -> tuple[bool, str]:
    sessions_root = Path.home() / ".codex" / "sessions"
    if not sessions_root.is_dir():
        return False, "~/.codex/sessions not found"
    for match in sessions_root.rglob(f"rollout-*-{session_id}.jsonl"):
        return True, str(match)
    return False, f"no rollout file matching rollout-*-{session_id}.jsonl under {sessions_root}"


def _find_codex_child_rollout(root_id: str) -> tuple[Optional[str], str]:
    """Find a Codex child rollout whose recorded parent is ``root_id``, read-only."""
    sessions_root = Path.home() / ".codex" / "sessions"
    if not sessions_root.is_dir():
        return None, "~/.codex/sessions not found"
    for path in sessions_root.rglob("rollout-*.jsonl"):
        try:
            first_event = json.loads(path.open(errors="replace").readline())
        except (OSError, json.JSONDecodeError):
            continue
        payload = first_event.get("payload") if isinstance(first_event, dict) else None
        if not isinstance(payload, dict) or payload.get("parent_thread_id") != root_id:
            continue
        child_id = payload.get("id")
        if child_id:
            return child_id, f"{path}: parent_thread_id={root_id!r}"
    return None, f"no child rollout with parent_thread_id={root_id!r} under {sessions_root}"


def _verify_disk(harness: str, session_id: str, cwd: str) -> tuple[bool, str]:
    if harness == "claude":
        return _verify_claude_disk(session_id, cwd)
    if harness == "opencode":
        return _verify_opencode_disk(session_id)
    return _verify_codex_disk(session_id)


# ---------------------------------------------------------------------------
# Link assertions shared by every cell
# ---------------------------------------------------------------------------

def _harness_args(harness: str) -> list[str]:
    """Model/provider pinning for cost control."""
    if harness == "claude":
        return ["--model", CLAUDE_MODEL]
    if harness == "opencode":
        return ["--model", OPENCODE_MODEL]
    # codex takes its model as config overrides; the provider comes from
    # ~/.codex/config.toml but is pinned here so the cell is self-contained.
    return ["--harness-arg", f"-c model={CODEX_MODEL}",
            "--harness-arg", f"-c model_provider={CODEX_PROVIDER}"]


def _launch(cmd: list[str], run_name: str, timeout: int, result: CellResult) -> bool:
    """Launch a run, registering it for teardown *before* the process starts.

    On timeout we do not assume the launch failed — the run may well be alive;
    run_cell's finally kills and reaps whatever this registered.
    """
    _active_runs.add(run_name)
    try:
        _run(*cmd, timeout=timeout)
        return True
    except subprocess.CalledProcessError as exc:
        result.fail("link1-launch", f"agent-run exited {exc.returncode}: {(exc.stderr or '')[:200]}")
    except subprocess.TimeoutExpired:
        result.fail("link1-launch", f"agent-run launch timed out ({timeout}s)")
    return False


def _await_done(run_name: str, result: CellResult) -> bool:
    status = _wait_for_terminal(run_name, RUN_TIMEOUT)
    if status != "done":
        result.fail("link1-run", f"status={status!r} (expected 'done')\nLog tail:\n{_log_tail(run_name)}")
        return False
    _log("  [link1] PASS status=done")
    return True


def _links_2_3_4(harness: str, run_name: str, expected_client: str, cwd: str,
                 result: CellResult) -> "tuple[str, dict] | None":
    """Assert session.json, the harness disk record and the DB row.

    Returns (session_id, links dict) or None once `result` holds the failure.
    """
    sj = _session_json(run_name)
    if sj is None:
        result.fail("link2-session-json", "session.json missing or malformed")
        return None
    session_id = sj.get("session_id") or sj.get("id")
    confidence = sj.get("confidence", "")
    acquisition = sj.get("acquisition", "")
    if not session_id:
        result.fail("link2-session-json", f"session.json has no session_id: {sj}")
        return None
    if confidence != "certain":
        result.fail("link2-session-json",
                    f"confidence={confidence!r} (expected 'certain'); acquisition={acquisition!r}")
        return None
    if acquisition not in ("pushed", "minted"):
        result.fail("link2-session-json",
                    f"implausible acquisition={acquisition!r} (expected pushed|minted)")
        return None
    _log(f"  [link2] PASS session_id={session_id!r} confidence={confidence} acquisition={acquisition}")

    ok, detail = _verify_disk(harness, session_id, cwd)
    if not ok:
        result.fail("link3-disk-record", detail)
        return None
    _log(f"  [link3] PASS disk: {detail}")

    _log(f"  Polling DB for client_sessions row (timeout={DB_POLL_TIMEOUT}s)…")
    row = _poll_db("client_session_id", session_id)
    if isinstance(row, _DbError):
        result.fail("link4-db-unreachable", f"DB transport error: {row.detail}")
        return None
    if row is None:
        result.fail("link4-db-row",
                    f"no client_sessions row for {session_id!r} after {DB_POLL_TIMEOUT}s")
        return None
    db_client = row.get("client", "")
    if db_client != expected_client:
        result.fail("link4-db-row",
                    f"client={db_client!r} (expected {expected_client!r}) for {session_id!r}")
        return None
    _log(f"  [link4] PASS DB: client={db_client!r} created_at={row.get('created_at','?')!r}")

    return session_id, {
        "link2": f"confidence={confidence} acquisition={acquisition}",
        "link3": detail,
        "link4": f"client={db_client}",
    }


def _reply_present(run_name: str, harness: str, token: str, min_count: int) -> bool:
    """True once the model has genuinely emitted `token` min_count times.

    For claude/opencode the raw log echoes the prompt, so the token must also
    appear in an assistant region of the rendered transcript.  Managed codex
    writes only agentMessage/delta payloads to the log, so the count suffices.
    """
    if harness == "codex":
        return _count_in_log(run_name, token) >= min_count
    return _count_in_assistant_region(run_name, token) >= min_count


def _reply_count(run_name: str, harness: str, token: str) -> int:
    """Occurrences that count as model output for this harness."""
    if harness == "codex":
        return _count_in_log(run_name, token)
    return _count_in_assistant_region(run_name, token)


def _wait_for_reply(run_name: str, harness: str, token: str, min_count: int,
                    timeout: float) -> bool:
    deadline = time.monotonic() + timeout
    while True:
        if _reply_present(run_name, harness, token, min_count):
            return True
        # One final look after the run ends or time runs out, in case the last
        # chunk of output landed between the check and the status read.
        if _agent_run_status(run_name) in TERMINAL_STATUSES or time.monotonic() >= deadline:
            return _reply_present(run_name, harness, token, min_count)
        time.sleep(1.0)


# ---------------------------------------------------------------------------
# Cells
# ---------------------------------------------------------------------------

def cell_oneshot(harness: str, run_name: str, expected_client: str, cwd: str,
                 result: CellResult) -> None:
    _log(f"  Launching {harness} one-shot → run={run_name!r}")
    cmd = ["agent-run", "--harness", harness, *_harness_args(harness),
           "--prompt", TURN1_PROMPT, run_name]
    if not _launch(cmd, run_name, 30, result):
        return
    _log(f"  Waiting for {run_name} to reach done (timeout={RUN_TIMEOUT}s)…")
    if not _await_done(run_name, result):
        return
    chain = _links_2_3_4(harness, run_name, expected_client, cwd, result)
    if chain is None:
        return
    session_id, links = chain
    result.pass_(session_id, {"link1": "done", **links})


def cell_interactive(harness: str, run_name: str, expected_client: str, cwd: str,
                     result: CellResult) -> None:
    """Launch a TUI, verify turn 1, steer, verify turn 2, then links 2–4.

    Liveness is asserted on tokens the model must synthesise (the answers are
    absent from the prompts) and, after the steer, on the turn-2 token's log
    count *increasing* — so neither prompt echo nor the turn-1 reply can stand
    in for an answer that never came.
    """
    _log(f"  Launching {harness} interactive → run={run_name!r}")
    cmd = ["agent-run", "-i", "--harness", harness, *_harness_args(harness),
           "--prompt", TURN1_PROMPT, run_name]
    if not _launch(cmd, run_name, 60, result):
        return

    _log(f"  Waiting for turn-1 reply {TURN1_TOKEN!r} in assistant region "
         f"(timeout={INTERACTIVE_FIRST_REPLY_TIMEOUT}s)…")
    if not _wait_for_reply(run_name, harness, TURN1_TOKEN, 1, INTERACTIVE_FIRST_REPLY_TIMEOUT):
        result.fail("link1-interactive-first-reply",
                    f"{TURN1_TOKEN!r} not in assistant region after "
                    f"{INTERACTIVE_FIRST_REPLY_TIMEOUT}s "
                    f"(status={_agent_run_status(run_name)!r})\nLog tail:\n{_log_tail(run_name)}")
        return
    _log(f"  [link1a] PASS: turn-1 reply {TURN1_TOKEN!r} seen in assistant region "
         f"(count={_reply_count(run_name, harness, TURN1_TOKEN)})")

    # Baseline before steering, so turn 2 must strictly add an occurrence.
    before_steer = _reply_count(run_name, harness, TURN2_TOKEN)
    _log("  Steering second prompt…")
    try:
        _run("agent-run", "steer", run_name, TURN2_PROMPT, timeout=15)
    except subprocess.CalledProcessError as exc:
        result.fail("link1-steer", f"agent-run steer failed: {(exc.stderr or '')[:200]}")
        return

    _log(f"  Waiting for turn-2 reply {TURN2_TOKEN!r} in assistant region "
         f"(timeout={INTERACTIVE_SECOND_REPLY_TIMEOUT}s)…")
    answered = _wait_for_reply(run_name, harness, TURN2_TOKEN, before_steer + 1,
                               INTERACTIVE_SECOND_REPLY_TIMEOUT)
    if not answered and _agent_run_status(run_name) not in TERMINAL_STATUSES:
        # A steer delivered while the TUI is mid-render can be swallowed; resend
        # once before concluding the turn was never answered.
        _log("  Turn-2 reply not seen; re-steering once…")
        try:
            _run("agent-run", "steer", run_name, TURN2_PROMPT, timeout=15)
            answered = _wait_for_reply(run_name, harness, TURN2_TOKEN, before_steer + 1,
                                       INTERACTIVE_SECOND_REPLY_TIMEOUT)
        except subprocess.CalledProcessError:
            answered = False
    if not answered:
        result.fail("link1-interactive-second-reply",
                    f"{TURN2_TOKEN!r} count did not rise above {before_steer} in an assistant "
                    f"region after {INTERACTIVE_SECOND_REPLY_TIMEOUT}s "
                    f"(status={_agent_run_status(run_name)!r})\nLog tail:\n{_log_tail(run_name)}")
        return
    _log(f"  [link1b] PASS: turn-2 reply {TURN2_TOKEN!r} seen in assistant region")

    chain = _links_2_3_4(harness, run_name, expected_client, cwd, result)
    if chain is None:
        return
    session_id, links = chain
    result.pass_(session_id, {"link1": "two turns answered", **links})


def cell_subagent(harness: str, run_name: str, expected_client: str, cwd: str,
                  result: CellResult) -> None:
    """One-shot run that spawns a sub-agent, plus link 5 (root→child linkage).

    For depth-1 claude sub-agents the proxy has no parent-agent-id header and
    resolves the parent from the root session id instead ("??-fallback"); the
    assertion is the same either way.
    """
    _log(f"  Launching {harness} sub-agent → run={run_name!r}")
    cmd = ["agent-run", "--harness", harness, *_harness_args(harness)]
    if harness == "opencode":
        cmd += ["--agent-mode", "build"]
    cmd += ["--prompt", SUBAGENT_PROMPTS[harness], run_name]
    if not _launch(cmd, run_name, 30, result):
        return
    if not _await_done(run_name, result):
        return
    chain = _links_2_3_4(harness, run_name, expected_client, cwd, result)
    if chain is None:
        return
    root_id, links = chain

    if harness == "codex":
        child_id, child_rollout = _find_codex_child_rollout(root_id)
        if child_id is None:
            result.fail("link3-child-rollout", child_rollout)
            return
        _log(f"  [link3-child] PASS rollout: {child_rollout}")
        links["link3-child"] = child_rollout

    # A child rollout or DB row alone doesn't prove the sub-agent completed.
    if "subpong" not in _read_log(run_name).lower():
        result.fail("link5-subagent-reply", "sub-agent never produced 'SUBPONG' in the run log")
        return
    _log("  [link5+] PASS sub-agent reply 'SUBPONG' confirmed in log")

    _log(f"  Polling DB for child row (parent={root_id!r}, timeout={DB_POLL_TIMEOUT}s)…")
    child = _poll_db("parent_client_session_id", root_id)
    if isinstance(child, _DbError):
        result.fail("link5-db-unreachable", f"DB transport error: {child.detail}")
        return
    if child is None:
        result.fail("link5-parent-linkage",
                    f"no child client_sessions row with parent_client_session_id={root_id!r} "
                    f"after {DB_POLL_TIMEOUT}s — sub-agent did not fire, or parent link broken")
        return
    child_id = child.get("client_session_id", "?")
    parent_id = child.get("parent_client_session_id", "?")
    _log(f"  [link5] PASS child={child_id!r} parent={parent_id!r} → resolves to root")

    result.pass_(root_id, {"link1": "done", **links,
                           "link5": f"child={child_id!r} parent={parent_id!r}"})


# Cell name → (harness, mode, expected client value in client_sessions)
CELLS = {
    "claude-oneshot":       ("claude",   "oneshot",     "claude-code"),
    "claude-interactive":   ("claude",   "interactive", "claude-code"),
    "opencode-oneshot":     ("opencode", "oneshot",     "opencode"),
    "opencode-interactive": ("opencode", "interactive", "opencode"),
    "codex-oneshot":        ("codex",    "oneshot",     "codex"),
    "codex-interactive":    ("codex",    "interactive", "codex"),
    "opencode-subagent":    ("opencode", "subagent",    "opencode"),
    "claude-subagent":      ("claude",   "subagent",    "claude-code"),
    "codex-subagent":       ("codex",    "subagent",    "codex"),
}


def run_cell(cell_name: str, keep: bool) -> CellResult:
    harness, mode, expected_client = CELLS[cell_name]
    result = CellResult(name=cell_name)
    rname = f"vsa-{cell_name.replace('-', '_')}-{uuid.uuid4().hex[:8]}"
    cwd = str(Path.cwd())

    _log(f"\n{'='*60}")
    _log(f"CELL: {cell_name}  (run={rname})")
    _log(f"{'='*60}")

    try:
        if mode == "oneshot":
            cell_oneshot(harness, rname, expected_client, cwd, result)
        elif mode == "interactive":
            cell_interactive(harness, rname, expected_client, cwd, result)
        elif mode == "subagent":
            cell_subagent(harness, rname, expected_client, cwd, result)
    except Exception as exc:
        import traceback
        result.fail("unexpected-exception", f"{type(exc).__name__}: {exc}\n{traceback.format_exc()}")
    finally:
        # Single teardown for every exit path — pass, fail, launch timeout or
        # exception. Cells never reap themselves.
        if rname in _active_runs:
            _kill_and_reap(rname, keep)

    _log(f"\n  → {result.verdict}: {cell_name}")
    if result.verdict == FAIL:
        _log(f"     FAILED at [{result.failure_link}]: {(result.failure_detail or '')[:200]}")
    elif result.verdict == SKIP:
        _log(f"     SKIP: {result.notes[0][:120] if result.notes else ''}")
    else:
        _log(f"     session_id={result.session_id!r}")
        for lk, lv in result.links.items():
            _log(f"     {lk}: {lv}")
    return result


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

HELP_EPILOG = textwrap.dedent("""
cells:
  claude-oneshot       claude one-shot (--print)
  claude-interactive   claude TUI with steer
  opencode-oneshot     opencode run (non-interactive)
  opencode-interactive opencode TUI with steer
  codex-oneshot        codex app-server one-shot
  codex-interactive    codex app-server interactive
  opencode-subagent    opencode: assert child parent linkage in DB (link 5)
  claude-subagent      claude: assert child parent linkage via ??-fallback (link 5)
  codex-subagent       codex: assert child rollout and DB parent linkage (links 3, 5)

DB access: ssh VIBES_HOST → ssh LLMPROXY_HOST → docker exec psql
  Set VIBES_HOST, LLMPROXY_HOST, POSTGRES_USER, POSTGRES_DB to override.

Approximate cost: ~$0.02–0.05 per full run (haiku/mini models, trivial prompts).

--keep preserves agent-run state and log dirs for debugging. The run itself is
still terminated, so no TUI or app-server is left behind.

Typical debug workflow:
  1. Run with --only claude-oneshot --keep to preserve run dirs.
  2. Check /var/tmp/agent-runs/<run>/session.json and log.
  3. Compare with ~/.claude/projects/<mangled>/<id>.jsonl.
""")


def main(argv: Optional[list[str]] = None) -> int:
    global _json_mode

    parser = argparse.ArgumentParser(
        prog="verify-session-attribution",
        description=(
            "End-to-end test for the agent-run session attribution chain:\n"
            "  session.json → harness disk record → wire header → llmproxy client_sessions row\n"
            "Exit non-zero on any FAIL. SKIP is distinct from FAIL."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=HELP_EPILOG,
    )
    parser.add_argument("--only", metavar="CELL[,CELL...]",
                        help="Run only the named cell(s), comma-separated")
    parser.add_argument("--harness", metavar="NAME",
                        help="Run only cells for this harness (claude|opencode|codex)")
    parser.add_argument("--skip-subagents", action="store_true", help="Skip all sub-agent cells")
    parser.add_argument("--keep", action="store_true",
                        help=("Preserve agent-run state and log dirs for debugging "
                              "(default: clean up). The run is still terminated."))
    parser.add_argument("--json", action="store_true",
                        help=("Emit machine-readable JSON summary to stdout; human log goes to "
                              "stderr. stdout is valid JSON on both pass and fail paths."))
    args = parser.parse_args(argv)
    _json_mode = args.json

    _install_signal_handlers()

    all_cells = list(CELLS)
    if args.only:
        cells_to_run = [c.strip() for c in args.only.split(",")]
        unknown = [c for c in cells_to_run if c not in CELLS]
        if unknown:
            parser.error(f"Unknown cells: {', '.join(unknown)}. Valid: {', '.join(all_cells)}")
    elif args.harness:
        if args.harness not in ("claude", "opencode", "codex"):
            parser.error(f"--harness must be claude|opencode|codex, got {args.harness!r}")
        cells_to_run = [c for c in all_cells if c.startswith(args.harness)]
    else:
        cells_to_run = all_cells

    if args.skip_subagents:
        cells_to_run = [c for c in cells_to_run if "subagent" not in c]

    _log("verify-session-attribution")
    _log(f"cells: {', '.join(cells_to_run)}")
    _log(f"DB: ssh {VIBES_HOST} → ssh {LLMPROXY_HOST} → psql -U {POSTGRES_USER} -d {POSTGRES_DB}")
    _log(f"keep={args.keep} skip-subagents={args.skip_subagents}")
    _log("")

    # Fail loud and fast if the DB path is down, so no cell has to report
    # "no row" for what is really a broken tunnel.
    if cells_to_run:
        _log("Checking DB path (preflight SELECT 1)…")
        db_err = _db_preflight()
        if db_err:
            _log(f"ABORT: {db_err}")
            _log("DB path is down — cannot distinguish 'no row' from 'transport error'.")
            _log("Fix the SSH tunnel / container before running.")
            return 1
        _log("DB preflight OK\n")

    results = [run_cell(cell_name, keep=args.keep) for cell_name in cells_to_run]

    _log(f"\n{'='*60}")
    _log("SUMMARY")
    _log(f"{'='*60}")
    pass_count = sum(1 for r in results if r.verdict == PASS)
    fail_count = sum(1 for r in results if r.verdict == FAIL)
    skip_count = sum(1 for r in results if r.verdict == SKIP)
    for r in results:
        marker = {PASS: "✓", FAIL: "✗", SKIP: "~"}.get(r.verdict, "?")
        sid = f"  sid={r.session_id!r}" if r.session_id else ""
        link = f"  [{r.failure_link}]" if r.verdict == FAIL else ""
        _log(f"  {marker} {r.verdict:4s}  {r.name}{sid}{link}")
        if r.verdict == FAIL and r.failure_detail:
            _log(f"         {r.failure_detail.splitlines()[0][:100]}")
    _log(f"\n  PASS={pass_count}  FAIL={fail_count}  SKIP={skip_count}")

    if args.json:
        print(json.dumps({
            "pass": pass_count, "fail": fail_count, "skip": skip_count,
            "cells": [
                {
                    "name": r.name,
                    "verdict": r.verdict,
                    "session_id": r.session_id,
                    "links": r.links,
                    "failure_link": r.failure_link,
                    "failure_detail": r.failure_detail,
                    "notes": r.notes,
                }
                for r in results
            ],
        }, indent=2))

    return 1 if fail_count > 0 else 0


if __name__ == "__main__":
    sys.exit(main())
