#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# ///
"""verify-harness-policy — end-to-end verifier for managed-mode capability policy.

Split into two tiers:

  Tier 1 — contract cells (no model calls, seconds, $0)
    C1  codex key exists:        tools.experimental_request_user_input key accepted by
                                 --strict-config; a generated nonsense key is rejected.
    C2  codex value shape:       bare boolean rejected with struct-type error, proving the
                                 struct literal is still required.
    C3  codex -c last-wins:      duplicate key: invalid-first/valid-last exits 0;
                                 valid-first/invalid-last exits non-zero.
    C4  claude tool names exist: --disallowedTools EnterPlanMode ExitPlanMode AskUserQuestion
                                 produces NO 'matches no known tool' warning; a bogus name
                                 MUST produce it. No model call: validation runs at startup.
    C5  claude variadic + additive: argv-consumption behaviour our ordering depends on;
                                 a multi-token value is split and each token is validated.
    C6  opencode resolver:       opencode debug agent confirms question/plan_enter/plan_exit
                                 are denied as the LAST matching rule, beating a project allow,
                                 for the default agent, --agent-mode agent, and --harness-arg
                                 --agent named agent.

  Tier 2 — behavioural cells (real API calls, costs money)
    A1  codex questions differential: functions.request_user_input present when enabled,
                                 absent when disabled, with functions.exec positive control.
                                 Repeated five times.
    A2  opencode deny beats allow: OPENCODE_CONFIG_CONTENT deny overrides project allow.
    A3  claude deny beats allow:  --disallowedTools Bash → Bash absent from tool_use records.
    A5  enabled arms enable:     positive proof that each harness observably enables the
                                 capability when flags are set.

Approximate cost per full run: ~$0.20–0.40 (Tier 2; haiku/mini models, trivial prompts).
Tier 1 alone: $0, seconds.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import textwrap
import time
import uuid
from dataclasses import dataclass, field
from pathlib import Path
from typing import Optional

# ---------------------------------------------------------------------------
# Repo-local import — must happen before any 'toolbox' import
# ---------------------------------------------------------------------------
# Resolve the repo root from this script's own path so the import works from
# any cwd, with any PYTHONPATH, regardless of which editable packages the
# calling environment has installed.  Prepending to sys.path[0] guarantees
# our src/ wins over any site-packages entry that might point at a different
# checkout of the same package.

_REPO_ROOT = Path(__file__).resolve().parent.parent
_REPO_SRC  = _REPO_ROOT / "src"

if str(_REPO_SRC) != sys.path[0] if sys.path else True:
    sys.path.insert(0, str(_REPO_SRC))

import toolbox.agent_run as _ar  # noqa: E402  (must follow sys.path setup)

# Hard assertion: if the resolved module file is not inside this repo, the
# sys.path insertion did not win (e.g. a .pth file or PYTHONPATH entry took
# precedence).  A mismatch must abort, not degrade to a skip — a verifier
# that silently validates the wrong source is worse than no verifier.
_EXPECTED_AR = (_REPO_SRC / "toolbox" / "agent_run.py").resolve()
_ACTUAL_AR   = Path(_ar.__file__).resolve()
if _ACTUAL_AR != _EXPECTED_AR:
    print(
        f"ABORT: toolbox.agent_run resolved to the wrong file.\n"
        f"  expected: {_EXPECTED_AR}\n"
        f"  got:      {_ACTUAL_AR}\n"
        f"A sys.path entry or .pth file is overriding the repo-local src/.\n"
        f"This verifier must only run against its own repository's source.",
        file=sys.stderr,
    )
    sys.exit(2)

# Canonical string used in header output and --json so every PASS record names
# the exact source file that was validated.
_AR_FILE: str = str(_ACTUAL_AR)

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

CLAUDE_MODEL   = os.environ.get("CLAUDE_MODEL",   "claude-haiku-4-5")
OPENCODE_MODEL = os.environ.get("OPENCODE_MODEL", "llmproxy-anthropic/claude-haiku-4.5")
CODEX_MODEL    = os.environ.get("CODEX_MODEL",    "gpt-5.4")
CODEX_PROVIDER = os.environ.get("CODEX_PROVIDER", "llmproxy")

# Timeout for a single subprocess in tier-2 cells (seconds).
LIVE_TIMEOUT = int(os.environ.get("VERIFY_POLICY_LIVE_TIMEOUT", "120"))

# Tier-1 subprocess timeout (seconds); all contract checks exit in well under a second.
CONTRACT_TIMEOUT = 10

PASS = "PASS"
FAIL = "FAIL"
SKIP = "SKIP"

_json_mode: bool = False


# ---------------------------------------------------------------------------
# Result dataclass
# ---------------------------------------------------------------------------

@dataclass
class CellResult:
    name: str
    verdict: str = FAIL
    version_info: dict = field(default_factory=dict)
    notes: list = field(default_factory=list)
    failure_detail: Optional[str] = None

    def pass_(self, note: str = "", *, versions: Optional[dict] = None) -> None:
        self.verdict = PASS
        if note:
            self.notes.append(note)
        if versions:
            self.version_info.update(versions)

    def skip(self, reason: str) -> None:
        self.verdict = SKIP
        self.notes.append(reason)

    def fail(self, detail: str) -> None:
        self.verdict = FAIL
        self.failure_detail = detail
        self.notes.append(f"FAIL: {detail}")


# ---------------------------------------------------------------------------
# Utilities
# ---------------------------------------------------------------------------

def _log(msg: str) -> None:
    print(msg, flush=True, file=sys.stderr if _json_mode else sys.stdout)


# Exit code and message emitted by `claude --print` when no prompt is supplied. Used as a
# positive control: reaching this error proves claude parsed its options and validated tool
# names, so an absent "matches no known tool" warning is meaningful.
CLAUDE_NO_PROMPT_RC = 1
CLAUDE_NO_PROMPT_ERROR = "Input must be provided"

# Exit code codex returns when --strict-config rejects a configuration value.
CODEX_CONFIG_ERROR_RC = 1


def _run(
    *cmd: str,
    timeout: int = CONTRACT_TIMEOUT,
    check: bool = False,
    env: Optional[dict] = None,
    cwd: Optional[str] = None,
    input: Optional[str] = None,
) -> subprocess.CompletedProcess:
    kwargs: dict = dict(
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )
    if env is not None:
        kwargs["env"] = env
    if cwd is not None:
        kwargs["cwd"] = cwd
    if input is not None:
        kwargs["input"] = input
    result = subprocess.run(list(cmd), **kwargs)
    if check and result.returncode != 0:
        raise subprocess.CalledProcessError(
            result.returncode, list(cmd), result.stdout, result.stderr
        )
    return result


def _binary_version(binary: str) -> Optional[str]:
    """Return the version string for a binary, or None if not found."""
    try:
        r = subprocess.run(
            [binary, "--version"], capture_output=True, text=True, timeout=5
        )
        out = (r.stdout + r.stderr).strip()
        return out.splitlines()[0] if out else None
    except (FileNotFoundError, OSError, subprocess.SubprocessError):
        return None


def _require_binary(name: str, result: CellResult) -> Optional[str]:
    """Return the binary path, or call result.skip and return None."""
    path = shutil.which(name)
    if not path:
        result.skip(f"binary '{name}' not found in PATH — skipping")
        return None
    return path


# ---------------------------------------------------------------------------
# Tier 1 — contract cells
# ---------------------------------------------------------------------------

# Codex writes sqlite state under its state root on every invocation. Point that
# root at a scratch directory so contract cells never touch the real ~/.codex.
_CODEX_STATE_ROOT: Optional[str] = None


def _codex_env() -> dict:
    """Environment for codex invocations with CODEX_HOME redirected to scratch."""
    global _CODEX_STATE_ROOT
    if _CODEX_STATE_ROOT is None:
        _CODEX_STATE_ROOT = tempfile.mkdtemp(prefix="vhp-codex-home-")
    return {**os.environ, "CODEX_HOME": _CODEX_STATE_ROOT}


def cell_c1_codex_key_exists(result: CellResult) -> None:
    """C1: tools.experimental_request_user_input accepted; a nonsense key is not.

    Both assertions are required. A tripwire with no negative control can fail
    open — if --strict-config itself stopped working, we'd never know.
    """
    if not _require_binary("codex", result):
        return

    version = _binary_version("codex") or "unknown"
    result.version_info["codex"] = version
    _log(f"  codex version: {version}")

    # Positive: the real key exits 0.
    pos = _run(
        "codex", "app-server", "--strict-config",
        "-c", "tools.experimental_request_user_input={enabled=false}",
        env=_codex_env(),
    )
    if pos.returncode != 0:
        result.fail(
            f"codex app-server --strict-config -c tools.experimental_request_user_input={{enabled=false}} "
            f"exited {pos.returncode} — key may have been renamed.\n"
            f"stderr: {pos.stderr[:300]}"
        )
        return
    _log("  [positive] real key accepted: exit 0")

    # Negative: a generated nonsense key must exit non-zero with 'unknown configuration field'.
    bogus = "tools.BOGUS_VERIFIER_KEY_NEVER_EXISTS_XYZ"
    neg = _run("codex", "app-server", "--strict-config", "-c", f"{bogus}=false",
               env=_codex_env())
    if neg.returncode == 0:
        result.fail(
            f"codex app-server --strict-config -c {bogus}=false exited 0; "
            "expected non-zero. --strict-config may no longer enforce unknown keys."
        )
        return
    if "unknown configuration field" not in neg.stderr:
        result.fail(
            f"bogus key exited non-zero but stderr lacks 'unknown configuration field'.\n"
            f"stderr: {neg.stderr[:300]}"
        )
        return
    _log("  [negative] bogus key rejected: non-zero + 'unknown configuration field'")

    result.pass_(
        f"real key accepted; bogus key rejected with 'unknown configuration field' (codex {version})"
    )


def cell_c2_codex_value_shape(result: CellResult) -> None:
    """C2: bare boolean rejected with struct-type error.

    The codex config layer requires a struct literal for this key; a bare boolean
    must fail with the struct-type error string. If codex ever accepts a boolean,
    our struct literal becomes fragile dead code.
    """
    if not _require_binary("codex", result):
        return

    version = _binary_version("codex") or "unknown"
    result.version_info["codex"] = version

    # Positive control: the struct literal must be ACCEPTED (exit 0). Without this a
    # binary that fails every invocation would satisfy the rejection arm below.
    ok = _run(
        "codex", "app-server", "--strict-config",
        "-c", "tools.experimental_request_user_input={enabled=false}",
        env=_codex_env(),
    )
    if ok.returncode != 0:
        result.fail(
            f"positive control failed: the struct literal exited {ok.returncode}, expected 0. "
            "codex is not behaving as a working binary, so the rejection arm below proves "
            f"nothing.\nstderr: {ok.stderr[:300]}"
        )
        return
    _log("  [positive control] struct literal accepted: exit 0")

    r = _run(
        "codex", "app-server", "--strict-config",
        "-c", "tools.experimental_request_user_input=false",
        env=_codex_env(),
    )
    if r.returncode != CODEX_CONFIG_ERROR_RC:
        result.fail(
            f"bare boolean 'false' exited {r.returncode}, expected {CODEX_CONFIG_ERROR_RC} "
            "(config rejection). If codex now accepts a boolean, _codex_policy_args() can "
            f"simplify — but verify first.\nstderr: {r.stderr[:300]}"
        )
        return
    # Match the full codex diagnostic: 'expected struct' alone also appears in unrelated
    # startup failures, which would let a broken binary satisfy this arm.
    if not (
        "invalid type: boolean" in r.stderr
        and "expected struct ExperimentalRequestUserInput" in r.stderr
    ):
        result.fail(
            f"bare boolean exited {r.returncode} but stderr lacks the codex struct-type "
            f"diagnostic.\nstderr: {r.stderr[:300]}"
        )
        return
    _log(f"  bare boolean rejected: exit {r.returncode}, struct-type diagnostic present")
    result.pass_(
        f"struct literal accepted; bare boolean rejected with struct-type error (codex {version})"
    )


def cell_c3_codex_last_wins(result: CellResult) -> None:
    """C3: duplicate -c overrides use last-occurrence-wins under --strict-config.

    The policy args are prepended so caller-supplied -c values override them
    (last wins). This cell verifies the semantic holds for the key we use:
    invalid-value-last must be rejected; invalid-value-first/valid-last must pass.
    """
    if not _require_binary("codex", result):
        return

    version = _binary_version("codex") or "unknown"
    result.version_info["codex"] = version

    key = "tools.experimental_request_user_input"
    valid   = f"{key}={{enabled=false}}"
    invalid = f"{key}=false"            # bare boolean — rejected with struct error

    # invalid-first / valid-last → last occurrence is valid → should exit 0.
    first_then_valid = _run(
        "codex", "app-server", "--strict-config",
        "-c", invalid,
        "-c", valid,
        env=_codex_env(),
    )
    # valid-first / invalid-last → last occurrence is invalid → should exit non-zero.
    first_then_invalid = _run(
        "codex", "app-server", "--strict-config",
        "-c", valid,
        "-c", invalid,
        env=_codex_env(),
    )

    if first_then_valid.returncode != 0:
        result.fail(
            "invalid-first/valid-last exited non-zero; expected 0 (last-wins not honoured).\n"
            f"stderr: {first_then_valid.stderr[:300]}"
        )
        return
    if first_then_invalid.returncode != CODEX_CONFIG_ERROR_RC:
        result.fail(
            f"valid-first/invalid-last exited {first_then_invalid.returncode}, expected "
            f"{CODEX_CONFIG_ERROR_RC} (config rejection). Either last-wins is not honoured or "
            f"codex failed for an unrelated reason.\nstderr: {first_then_invalid.stderr[:300]}"
        )
        return

    _log(f"  invalid-first/valid-last: exit {first_then_valid.returncode} (OK)")
    _log(f"  valid-first/invalid-last: exit {first_then_invalid.returncode} (OK)")
    result.pass_(f"last-occurrence-wins confirmed for {key} (codex {version})")


def cell_c4_claude_tool_names(result: CellResult) -> None:
    """C4: EnterPlanMode/ExitPlanMode/AskUserQuestion are known tool names.

    Claude's --disallowedTools flag is variadic and also splits each value on spaces,
    so passing a space-separated multi-word value to --disallowedTools causes claude
    to validate each word as a tool name at startup — before any model call. The
    process exits in ~0.3 s, producing a 'matches no known tool' warning to stderr
    for any unrecognised name.

    Two assertions:
      Positive: the three policy tool names produce NO warning.
      Negative: a sentinel bogus name MUST produce the warning.

    If the positive check fails, the deny is silently broken: we pass tool names to
    --disallowedTools that claude does not recognise and therefore ignores.
    If the negative check fails, we can no longer distinguish 'all recognised' from
    'command errored before validation'.
    """
    if not _require_binary("claude", result):
        return

    version = _binary_version("claude") or "unknown"
    result.version_info["claude"] = version
    _log(f"  claude version: {version}")

    # Passing a space-joined value causes claude to split and validate each token.
    # The run exits rc=1 ('Input must be provided') in ~0.3s — no model call.
    # NOTE: claude suppresses "matches no known tool" for names containing underscores
    # (treats them as namespace-qualified) — bogus names must be plain CamelCase or
    # uppercase without underscores to reliably trigger the warning.
    real_tools = "EnterPlanMode ExitPlanMode AskUserQuestion"
    bogus_tool  = "BOGUSVERIFY SENTINELA SENTINELB"  # three unknown, no underscores

    pos = _run(
        "claude", "--print", "--permission-mode", "bypassPermissions",
        "--disallowedTools", real_tools,
    )
    # Positive control: claude must reach prompt validation, proving it parsed the
    # --disallowedTools option. Absence of a warning from a binary that never got that
    # far would otherwise read as "all names recognised".
    if pos.returncode != CLAUDE_NO_PROMPT_RC or CLAUDE_NO_PROMPT_ERROR not in pos.stderr:
        result.fail(
            f"positive control failed: expected exit {CLAUDE_NO_PROMPT_RC} with "
            f"{CLAUDE_NO_PROMPT_ERROR!r}, got exit {pos.returncode}. claude did not reach "
            f"tool-name validation, so this cell proves nothing.\nstderr: {pos.stderr[:400]}"
        )
        return
    if "matches no known tool" in pos.stderr:
        result.fail(
            "One or more of EnterPlanMode/ExitPlanMode/AskUserQuestion produced "
            "'matches no known tool' — the tool has been renamed or removed. "
            "The deny is silently broken.\n"
            f"stderr: {pos.stderr[:400]}"
        )
        return
    _log(f"  [positive control] claude reached prompt validation: rc={pos.returncode}")
    _log(f"  [positive] real policy tools: no 'matches no known tool' in stderr")

    neg = _run(
        "claude", "--print", "--permission-mode", "bypassPermissions",
        "--disallowedTools", bogus_tool,
    )
    if neg.returncode != CLAUDE_NO_PROMPT_RC or CLAUDE_NO_PROMPT_ERROR not in neg.stderr:
        result.fail(
            f"negative-control invocation did not reach prompt validation: expected exit "
            f"{CLAUDE_NO_PROMPT_RC}, got {neg.returncode}.\nstderr: {neg.stderr[:400]}"
        )
        return
    if "matches no known tool" not in neg.stderr:
        result.fail(
            f"Bogus tool names {bogus_tool!r} did NOT produce 'matches no known tool' warning. "
            "The negative control is broken — we cannot distinguish 'all recognised' from "
            "'validation skipped'. Check if claude's tool-name validation changed.\n"
            f"stderr: {neg.stderr[:400]}"
        )
        return
    _log(f"  [negative] bogus tool names: 'matches no known tool' in stderr (OK)")

    result.pass_(
        f"EnterPlanMode/ExitPlanMode/AskUserQuestion are known tools; "
        f"bogus names produce the expected warning. No model call required. (claude {version})"
    )


def cell_c5_claude_variadic_additive(result: CellResult) -> None:
    """C5: --disallowedTools is variadic (splits on space) and additive (not last-wins).

    Our argv build relies on two properties:
      1. A single --disallowedTools value is split on spaces — each word is one tool name.
      2. Multiple --disallowedTools occurrences are additive, not last-wins.

    If either property changes, the deny set silently contracts.
    """
    if not _require_binary("claude", result):
        return

    version = _binary_version("claude") or "unknown"
    result.version_info["claude"] = version

    # Variadic: pass three known tool names as ONE space-separated value.
    # None of the three should produce a warning (they are all known tools).
    # NOTE: claude only emits "matches no known tool" for tool names that do NOT
    # contain underscores. Names like "BOGUS_XYZ" are silently ignored (treated
    # as namespace-qualified). Bogus names in this cell use plain uppercase words.
    variadic_check = _run(
        "claude", "--print", "--permission-mode", "bypassPermissions",
        "--disallowedTools", "EnterPlanMode ExitPlanMode AskUserQuestion",
    )
    if (
        variadic_check.returncode != CLAUDE_NO_PROMPT_RC
        or CLAUDE_NO_PROMPT_ERROR not in variadic_check.stderr
    ):
        result.fail(
            f"positive control failed: expected exit {CLAUDE_NO_PROMPT_RC} with "
            f"{CLAUDE_NO_PROMPT_ERROR!r}, got exit {variadic_check.returncode}. claude did not "
            f"parse the option, so split semantics are unproven.\n"
            f"stderr: {variadic_check.stderr[:400]}"
        )
        return
    if "matches no known tool" in variadic_check.stderr:
        result.fail(
            "Variadic split check: one or more of EnterPlanMode/ExitPlanMode/AskUserQuestion "
            "produced 'matches no known tool'. Either the split no longer occurs or the tools "
            "are no longer known.\n"
            f"stderr: {variadic_check.stderr[:400]}"
        )
        return
    _log("  [variadic] space-split recognized: three known tools, no warning")

    # Additive: two separate --disallowedTools blocks, each with two bogus names (no underscores).
    # All four unknown tokens must appear in stderr, proving both blocks are applied.
    additive_check = _run(
        "claude", "--print", "--permission-mode", "bypassPermissions",
        "--disallowedTools", "BOGUSADDA BOGUSADDB",
        "--disallowedTools", "BOGUSADDC BOGUSADDD",
    )
    if (
        additive_check.returncode != CLAUDE_NO_PROMPT_RC
        or CLAUDE_NO_PROMPT_ERROR not in additive_check.stderr
    ):
        result.fail(
            f"additive-check invocation did not reach prompt validation: expected exit "
            f"{CLAUDE_NO_PROMPT_RC}, got {additive_check.returncode}. Token presence in stderr "
            f"would not prove option semantics.\nstderr: {additive_check.stderr[:400]}"
        )
        return
    for token in ("BOGUSADDA", "BOGUSADDB", "BOGUSADDC", "BOGUSADDD"):
        if token not in additive_check.stderr:
            result.fail(
                f"Additive check: {token!r} not found in stderr — second --disallowedTools "
                "block may have overwritten the first (last-wins, not additive).\n"
                f"stderr: {additive_check.stderr[:400]}"
            )
            return
    _log("  [additive] both --disallowedTools blocks applied: all four bogus tokens in stderr")

    result.pass_(
        f"--disallowedTools is variadic (space-split) and additive (both blocks applied). "
        f"(claude {version})"
    )


def _last_rules_for_keys(
    debug_output: str, keys: list[str]
) -> dict[str, Optional[str]]:
    """Parse `opencode debug agent` JSON output and return the last-matching action per key."""
    try:
        data = json.loads(debug_output)
    except json.JSONDecodeError:
        return {k: None for k in keys}
    last: dict[str, Optional[str]] = {k: None for k in keys}
    for rule in data.get("permission", []):
        k = rule.get("permission")
        if k in last:
            last[k] = rule.get("action")
    return last


def cell_c6_opencode_resolver(result: CellResult, tmp_dir: str) -> None:
    """C6: opencode debug agent confirms deny is the last rule, even vs a project allow.

    Each scenario builds OPENCODE_CONFIG_CONTENT by calling the real
    ar._opencode_policy_config() with arguments that mirror how _cmd_launch_locked
    computes them in production. A local reimplementation would pass even if the
    production builder is gutted (e.g. target_agents emptied — the bug from 7a067c2).

    Six scenarios via opencode debug agent (no model call, confirmed working):
      1. Default agent (build): opencode_agent_mode=None, no extra names.
      2. --agent-mode agent: opencode_agent_mode=<name>.
      3. --harness-arg --agent: extra_agent_names from _opencode_agent_names_from_harness_args.
      4. Project per-agent allow defeated: also folds in _opencode_collect_config_agent_names
         so the config-enumeration path is exercised.
      5. OPENCODE_CONFIG env override: same as 4 with an extra OPENCODE_CONFIG file.
      6. Enabled arm: all three keys are 'allow' when both enable flags are set.
    """
    if not _require_binary("opencode", result):
        return

    version = _binary_version("opencode") or "unknown"
    result.version_info["opencode"] = version
    _log(f"  opencode version: {version}")

    policy_keys = ["question", "plan_enter", "plan_exit"]

    # Isolated XDG home shared across scenarios so no operator config leaks in.
    empty_xdg = os.path.join(tmp_dir, "empty_xdg")
    os.makedirs(empty_xdg, exist_ok=True)

    def _check(
        scenario: str,
        agent_name: str,
        env_overrides: dict,
        cwd: Optional[str] = None,
        expect_deny: bool = True,
    ) -> Optional[str]:
        """Run opencode debug agent <name> and return an error string or None."""
        env = {**os.environ, "XDG_CONFIG_HOME": empty_xdg, **env_overrides}
        try:
            r = _run("opencode", "debug", "agent", agent_name, env=env, cwd=cwd)
        except subprocess.TimeoutExpired:
            return f"opencode debug agent {agent_name!r} timed out"
        if r.returncode != 0:
            return (
                f"opencode debug agent {agent_name!r} exited {r.returncode}.\n"
                f"stderr: {r.stderr[:300]}"
            )
        last = _last_rules_for_keys(r.stdout, policy_keys)
        expected_action = "deny" if expect_deny else "allow"
        errors: list[str] = []
        for k in policy_keys:
            if last[k] != expected_action:
                errors.append(
                    f"  {k}: last rule is {last[k]!r}, expected {expected_action!r}"
                )
        if errors:
            return (
                f"{scenario}: policy mismatch:\n" + "\n".join(errors) + "\n"
                f"  (opencode debug agent output: {r.stdout[:400]})"
            )
        return None

    # 1. Default agent (build): opencode_agent_mode=None, no extra names.
    #    Use a project that grants per-agent allow for 'build' so the test is non-vacuous:
    #    if _opencode_policy_config omits the 'build' per-agent deny block (e.g. because
    #    target_agents is not initialised to {"build"}), the project allow wins and this
    #    scenario fails — which is exactly the regression from 7a067c2/870dd7f.
    project_dir_s1 = os.path.join(tmp_dir, "project_s1")
    os.makedirs(project_dir_s1, exist_ok=True)
    build_allow_cfg = {
        "agent": {
            "build": {
                "permission": {"question": "allow", "plan_enter": "allow", "plan_exit": "allow"}
            }
        }
    }
    with open(os.path.join(project_dir_s1, "opencode.json"), "w") as f:
        json.dump(build_allow_cfg, f)
    policy_env1 = _ar._opencode_policy_config(
        None,
        enable_planning=False,
        enable_questions=False,
        opencode_agent_mode=None,
        extra_agent_names=None,  # empty: mirrors a launch with no harness args and no config agents
    )
    err = _check("default agent (build) vs project allow", "build",
                 {"OPENCODE_CONFIG_CONTENT": policy_env1}, cwd=project_dir_s1)
    if err:
        result.fail(err)
        return
    _log("  [1] default agent (build): deny wins over project allow")

    # 2. --agent-mode agent: production passes opencode_agent_mode to the policy builder.
    agent_mode_name = "myagent_mode_test"
    policy_env2 = _ar._opencode_policy_config(
        None,
        enable_planning=False,
        enable_questions=False,
        opencode_agent_mode=agent_mode_name,
        extra_agent_names=None,
    )
    err = _check(
        f"--agent-mode agent ({agent_mode_name!r})", agent_mode_name,
        {"OPENCODE_CONFIG_CONTENT": policy_env2},
    )
    if err:
        result.fail(err)
        return
    _log(f"  [2] --agent-mode agent ({agent_mode_name!r}): deny wins")

    # 3. Agent named via --harness-arg --agent: production calls
    #    _opencode_agent_names_from_harness_args to extract the name, then passes it
    #    as extra_agent_names. Exercising that extraction path here catches regressions
    #    in _opencode_agent_names_from_harness_args itself.
    harness_arg_name = "myharness_arg_agent"
    extra_from_harness_args = _ar._opencode_agent_names_from_harness_args(
        ["--agent", harness_arg_name]
    )
    policy_env3 = _ar._opencode_policy_config(
        None,
        enable_planning=False,
        enable_questions=False,
        opencode_agent_mode=None,
        extra_agent_names=extra_from_harness_args,
    )
    err = _check(
        f"--harness-arg --agent ({harness_arg_name!r})", harness_arg_name,
        {"OPENCODE_CONFIG_CONTENT": policy_env3},
    )
    if err:
        result.fail(err)
        return
    _log(f"  [3] --harness-arg --agent ({harness_arg_name!r}): deny wins")

    # 4. Project per-agent allow defeated: a project opencode.json grants question/plan=allow
    #    for 'build'. Production folds in _opencode_collect_config_agent_names(cwd) so agents
    #    defined in the project config also get a deny block. Test that path here.
    project_dir = os.path.join(tmp_dir, "project_allow")
    os.makedirs(project_dir, exist_ok=True)
    project_cfg = {
        "agent": {
            "build": {
                "permission": {
                    "question": "allow",
                    "plan_enter": "allow",
                    "plan_exit": "allow",
                }
            }
        }
    }
    with open(os.path.join(project_dir, "opencode.json"), "w") as f:
        json.dump(project_cfg, f)
    # Mirror production: collect agent names from config sources, then build policy.
    config_agent_names = _ar._opencode_collect_config_agent_names(project_dir)
    policy_env4 = _ar._opencode_policy_config(
        None,
        enable_planning=False,
        enable_questions=False,
        opencode_agent_mode=None,
        extra_agent_names=config_agent_names,
    )
    err = _check(
        "project-allow vs OPENCODE_CONFIG_CONTENT deny", "build",
        {"OPENCODE_CONFIG_CONTENT": policy_env4},
        cwd=project_dir,
    )
    if err:
        result.fail(err)
        return
    _log("  [4] project-allow vs OPENCODE_CONFIG_CONTENT deny: deny wins (last-match)")

    # 5. OPENCODE_CONFIG env override: same config-enumeration path, extra OPENCODE_CONFIG
    #    file that re-grants allow for build. Policy must still deny.
    cfg_file = os.path.join(tmp_dir, "extra_allow.json")
    with open(cfg_file, "w") as f:
        json.dump(project_cfg, f)  # same project_cfg: grants allow for build
    # _opencode_collect_config_agent_names reads OPENCODE_CONFIG from the environment;
    # pass it explicitly here so the cell is self-contained.
    config_agent_names5 = _ar._opencode_collect_config_agent_names(project_dir)
    # Also pick up any agents named in the OPENCODE_CONFIG file.
    oc_cfg_data = json.loads(Path(cfg_file).read_text())
    for name in (oc_cfg_data.get("agent") or {}):
        config_agent_names5.add(name)
    policy_env5 = _ar._opencode_policy_config(
        None,
        enable_planning=False,
        enable_questions=False,
        opencode_agent_mode=None,
        extra_agent_names=config_agent_names5,
    )
    err = _check(
        "OPENCODE_CONFIG env override", "build",
        {"OPENCODE_CONFIG_CONTENT": policy_env5, "OPENCODE_CONFIG": cfg_file},
        cwd=project_dir,
    )
    if err:
        result.fail(err)
        return
    _log("  [5] OPENCODE_CONFIG env override: deny wins")

    # 6. Enabled arm: both flags set → last rule must be 'allow' for all three keys.
    policy_env6 = _ar._opencode_policy_config(
        None,
        enable_planning=True,
        enable_questions=True,
        opencode_agent_mode=None,
        extra_agent_names=None,
    )
    err = _check(
        "enabled arm (question=allow, plan=allow)", "build",
        {"OPENCODE_CONFIG_CONTENT": policy_env6},
        expect_deny=False,
    )
    if err:
        result.fail(err)
        return
    _log("  [6] enabled arm: last rule is 'allow' for all three keys")

    result.pass_(
        f"all 6 resolver scenarios: deny wins over project allow, "
        f"per-agent blocks created for named agents, enabled arm verified. "
        f"(opencode {version})"
    )


# ---------------------------------------------------------------------------
# Tier 2 — behavioural cells (real API calls)
# ---------------------------------------------------------------------------

def _import_live_helpers():
    """Import helpers from test_agent_run_live_acceptance without executing it.

    Loading by explicit file path (spec_from_file_location) prevents falling back
    to an installed copy of the test module. The loaded module's own 'from toolbox
    import agent_run' resolves via sys.path, which already has our repo's src/ at
    position 0 (set at module startup), so it also imports the right agent_run.
    """
    import importlib.util, pathlib
    test_file = pathlib.Path(__file__).parent.parent / "tests" / "test_agent_run_live_acceptance.py"
    spec = importlib.util.spec_from_file_location("_live_acceptance", str(test_file))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def cell_a1_codex_questions_differential(result: CellResult, tmp_dir: str) -> None:
    """A1: functions.request_user_input absent when disabled, present when enabled.

    Reuses _a1_run_arm from test_agent_run_live_acceptance. Runs five times each arm.
    """
    if not _require_binary("codex", result):
        return

    version = _binary_version("codex") or "unknown"
    result.version_info["codex"] = version

    try:
        live = _import_live_helpers()
    except Exception as exc:
        result.fail(f"could not import live-acceptance helpers: {exc}")
        return

    from pathlib import Path
    state_root = Path(tmp_dir) / "a1_state"
    log_root   = Path(tmp_dir) / "a1_logs"
    state_root.mkdir(parents=True, exist_ok=True)
    log_root.mkdir(parents=True, exist_ok=True)

    # Temporarily redirect agent-run roots to our temp dirs.
    orig_state = _ar.STATE_ROOT
    orig_log   = _ar.LOG_ROOT
    _ar.STATE_ROOT = state_root
    _ar.LOG_ROOT   = log_root

    repeats   = live._A1_REPEATS
    sentinel  = live._A1_SENTINEL
    diff_tool = live._A1_DIFFERENTIAL
    failures: list[str] = []
    enabled_passes = disabled_passes = 0

    try:
        for i in range(repeats):
            _log(f"  A1 repeat {i+1}/{repeats}…")
            e = live._a1_run_arm(True,  f"vhp-a1-enabled-{i}",  state_root, log_root)
            d = live._a1_run_arm(False, f"vhp-a1-disabled-{i}", state_root, log_root)

            if not e["has_sentinel"]:
                failures.append(
                    f"repeat {i} enabled: {sentinel!r} absent — no valid tool list "
                    f"(status={e['status']})"
                )
                continue
            if not d["has_sentinel"]:
                failures.append(
                    f"repeat {i} disabled: {sentinel!r} absent — no valid tool list "
                    f"(status={d['status']})"
                )
                continue

            if e["has_differential"]:
                enabled_passes += 1
            else:
                failures.append(
                    f"repeat {i} enabled: {diff_tool!r} absent despite enable_questions=True; "
                    f"tools={e['tools']}"
                )
            if not d["has_differential"]:
                disabled_passes += 1
            else:
                failures.append(
                    f"repeat {i} disabled: {diff_tool!r} present despite enable_questions=False; "
                    f"tools={d['tools']}"
                )
    finally:
        _ar.STATE_ROOT = orig_state
        _ar.LOG_ROOT   = orig_log

    summary = (
        f"enabled {enabled_passes}/{repeats} passes, disabled {disabled_passes}/{repeats} passes"
    )
    _log(f"  A1 summary: {summary}")
    if failures:
        result.fail(f"A1 failures ({summary}):\n" + "\n".join(failures))
        return
    if enabled_passes < repeats or disabled_passes < repeats:
        result.fail(f"A1 did not reach {repeats}/{repeats}: {summary}")
        return
    result.pass_(summary, versions={"codex": version})


def cell_a2_opencode_deny_beats_allow(result: CellResult, tmp_dir: str) -> None:
    """A2: OPENCODE_CONFIG_CONTENT deny overrides project opencode.json allow.

    Uses ``bash`` as the observable capability because the three policy keys
    (question, plan_enter, plan_exit) cannot be driven on demand from a prompt.

    The deny config is produced by ``_opencode_policy_config()`` with the bash deny
    supplied as inherited content, so this cell also exercises that function's
    documented contract that unrelated caller keys survive the merge. A builder that
    dropped or clobbered inherited permission keys would let the project allow win
    and fail this cell.
    """
    if not _require_binary("opencode", result):
        return

    version = _binary_version("opencode") or "unknown"
    result.version_info["opencode"] = version

    try:
        live = _import_live_helpers()
    except Exception as exc:
        result.fail(f"could not import live-acceptance helpers: {exc}")
        return

    import toolbox.agent_run as ar
    from pathlib import Path

    project = Path(tmp_dir) / "a2_project"
    project.mkdir(parents=True, exist_ok=True)
    (project / "opencode.json").write_text(json.dumps({"permission": {"bash": "allow"}}))

    prompt = "Run: echo SENTINEL_OUTPUT_XYZ"

    # Control: project allow → bash invoked.
    _log("  A2 control arm (bash allowed by project)…")
    ctrl_tools, ctrl_text, ctrl_proc = live._opencode_subprocess(
        prompt, project, timeout=LIVE_TIMEOUT
    )
    if ctrl_proc.returncode != 0:
        result.fail(
            f"A2 control arm: opencode exited {ctrl_proc.returncode}; "
            f"process failure, not policy evidence.\nstderr={ctrl_proc.stderr[:300]!r}"
        )
        return
    if "bash" not in ctrl_tools:
        result.fail(
            f"A2 control arm: 'bash' not invoked despite project allow. "
            f"tools={ctrl_tools!r} text={ctrl_text[:200]!r}"
        )
        return
    _log("  [control] bash invoked (allow confirmed)")

    # Deny arm: the bash deny is routed through the production builder as inherited
    # content, so the merge must preserve it alongside the injected policy keys.
    deny_cfg = ar._opencode_policy_config(
        json.dumps({"permission": {"bash": "deny"}}),
        enable_planning=False,
        enable_questions=False,
    )
    if json.loads(deny_cfg).get("permission", {}).get("bash") != "deny":
        result.fail(
            "_opencode_policy_config() dropped the inherited 'bash' permission; the merge "
            f"contract is broken.\nproduced: {deny_cfg[:300]}"
        )
        return
    _log("  A2 deny arm (bash denied by OPENCODE_CONFIG_CONTENT)…")
    deny_tools, deny_text, deny_proc = live._opencode_subprocess(
        prompt, project,
        extra_env={"OPENCODE_CONFIG_CONTENT": deny_cfg},
        timeout=LIVE_TIMEOUT,
    )
    if deny_proc.returncode != 0:
        result.fail(
            f"A2 deny arm: opencode exited {deny_proc.returncode}; "
            f"process failure.\nstderr={deny_proc.stderr[:300]!r}"
        )
        return
    if not deny_text.strip():
        result.fail(
            "A2 deny arm positive control failed: OpenCode produced no text output. "
            f"tools={deny_tools!r}"
        )
        return
    if "bash" in deny_tools:
        result.fail(
            f"A2 deny arm: 'bash' was invoked despite deny. tools={deny_tools!r}"
        )
        return
    _log("  [deny] bash absent from tool_use records (deny confirmed)")

    result.pass_(
        f"project allow overridden by OPENCODE_CONFIG_CONTENT deny. (opencode {version})"
    )


def cell_a3_claude_deny_beats_allow(result: CellResult) -> None:
    """A3: --disallowedTools Bash → Bash absent from tool_use records.

    Assertions are on tool_use records, not side effects.
    Reuses _claude_stream_tool_names from test_agent_run_live_acceptance.
    EnterPlanMode/AskUserQuestion are not available in this workspace; the test
    uses Bash as a proxy tool, with a skip-reason test matching A3's own tripwire.
    """
    if not _require_binary("claude", result):
        return

    version = _binary_version("claude") or "unknown"
    result.version_info["claude"] = version

    try:
        live = _import_live_helpers()
    except Exception as exc:
        result.fail(f"could not import live-acceptance helpers: {exc}")
        return

    prompt = "Use Bash to run: echo hello"

    # Control: no --disallowedTools → Bash invoked.
    _log("  A3 control arm (no --disallowedTools)…")
    try:
        ctrl_names, ctrl_text = live._claude_stream_tool_names(prompt, timeout=LIVE_TIMEOUT)
    except AssertionError as exc:
        result.fail(f"A3 control arm: {exc}")
        return
    if not ctrl_text.strip():
        result.fail(f"A3 control arm: Claude produced no output. tool_names={ctrl_names!r}")
        return
    if "Bash" not in ctrl_names:
        result.fail(
            f"A3 control arm: 'Bash' not in tool_names — not invoked. "
            f"tool_names={ctrl_names!r} result={ctrl_text[:200]!r}"
        )
        return
    _log(f"  [control] 'Bash' in tool_names: {ctrl_names!r}")

    # Deny arm: --disallowedTools Bash → Bash absent.
    _log("  A3 deny arm (--disallowedTools Bash)…")
    try:
        deny_names, deny_text = live._claude_stream_tool_names(
            prompt, extra_argv=["--disallowedTools", "Bash"], timeout=LIVE_TIMEOUT
        )
    except AssertionError as exc:
        result.fail(f"A3 deny arm: {exc}")
        return
    if not deny_text.strip():
        result.fail(
            f"A3 deny arm positive control failed: Claude produced no output. "
            f"tool_names={deny_names!r}"
        )
        return
    if "Bash" in deny_names:
        result.fail(
            f"A3 deny arm: 'Bash' found in tool_names despite --disallowedTools Bash. "
            f"tool_names={deny_names!r}"
        )
        return
    _log(f"  [deny] 'Bash' absent from tool_names: {deny_names!r}")

    result.pass_(
        f"Bash invoked in control arm; absent in deny arm. (claude {version})"
    )


def cell_a5_enabled_arms(result: CellResult, tmp_dir: str) -> None:
    """A5: enabled arms observably enable each harness's capability.

    Codex: functions.request_user_input present when enable_questions=True.
    OpenCode: policy merge with question=allow does not corrupt bash allow.
    Claude: Bash callable (no --disallowedTools in argv).
    """
    # Check all three binaries first and collect their versions.
    for binary in ("codex", "opencode", "claude"):
        if not shutil.which(binary):
            result.skip(f"binary '{binary}' not found — skipping A5")
            return

    result.version_info["codex"]    = _binary_version("codex")    or "unknown"
    result.version_info["opencode"] = _binary_version("opencode") or "unknown"
    result.version_info["claude"]   = _binary_version("claude")   or "unknown"

    try:
        live = _import_live_helpers()
    except Exception as exc:
        result.fail(f"could not import live-acceptance helpers: {exc}")
        return

    # — codex —
    _log("  A5 codex: functions.request_user_input when enable_questions=True…")
    state_root = Path(tmp_dir) / "a5_state"
    log_root   = Path(tmp_dir) / "a5_logs"
    state_root.mkdir(parents=True, exist_ok=True)
    log_root.mkdir(parents=True, exist_ok=True)
    orig_state, orig_log = _ar.STATE_ROOT, _ar.LOG_ROOT
    _ar.STATE_ROOT, _ar.LOG_ROOT = state_root, log_root
    try:
        obs = live._a1_run_arm(True, "vhp-a5-codex", state_root, log_root)
    finally:
        _ar.STATE_ROOT, _ar.LOG_ROOT = orig_state, orig_log

    if not obs["has_sentinel"]:
        result.fail(
            f"A5 codex: {live._A1_SENTINEL!r} absent — no valid tool list. "
            f"status={obs['status']}"
        )
        return
    if not obs["has_differential"]:
        result.fail(
            f"A5 codex: {live._A1_DIFFERENTIAL!r} not present despite enable_questions=True. "
            f"tools={obs['tools']}"
        )
        return
    _log(f"  A5 codex: {live._A1_DIFFERENTIAL!r} present (OK)")

    # — opencode —
    _log("  A5 opencode: question=allow does not block bash…")
    project = Path(tmp_dir) / "a5_oc_project"
    project.mkdir(parents=True, exist_ok=True)
    (project / "opencode.json").write_text(json.dumps({"permission": {"bash": "allow"}}))
    enable_q_cfg = _ar._opencode_policy_config(None, enable_planning=False, enable_questions=True)
    oc_tools, _, oc_proc = live._opencode_subprocess(
        "Run: echo SENTINEL_OUTPUT_XYZ", project,
        extra_env={"OPENCODE_CONFIG_CONTENT": enable_q_cfg},
        timeout=LIVE_TIMEOUT,
    )
    if oc_proc.returncode != 0:
        result.fail(
            f"A5 opencode: process failure exit {oc_proc.returncode}. "
            f"stderr={oc_proc.stderr[:300]!r}"
        )
        return
    if "bash" not in oc_tools:
        result.fail(
            f"A5 opencode: bash not invoked when question=allow. tools={oc_tools!r}"
        )
        return
    _log("  A5 opencode: bash invoked (OK)")

    # — claude —
    _log("  A5 claude: enabled argv has no --disallowedTools…")
    argv = _ar._build_managed_argv(
        "claude",
        interactive=False,
        prompt="placeholder",
        model=None,
        agent_mode=None,
        session_id="00000000-0000-4000-8000-000000000001",
        harness_args=[],
        enable_planning=True,
        enable_questions=True,
    )
    if "--disallowedTools" in argv:
        result.fail(
            f"A5 claude: --disallowedTools present in enabled-arm argv: {argv}"
        )
        return
    _log("  A5 claude: --disallowedTools absent in enabled-arm argv (OK)")

    result.pass_(
        "codex: differential tool present; opencode: bash allowed; claude: no deny flags"
    )


# ---------------------------------------------------------------------------
# Cell registry
# ---------------------------------------------------------------------------

# (name, tier, function, needs_tmp_dir)
CELLS_FREE: list[tuple] = [
    ("C1-codex-key-exists",    cell_c1_codex_key_exists,    False),
    ("C2-codex-value-shape",   cell_c2_codex_value_shape,   False),
    ("C3-codex-last-wins",     cell_c3_codex_last_wins,     False),
    ("C4-claude-tool-names",   cell_c4_claude_tool_names,   False),
    ("C5-claude-variadic",     cell_c5_claude_variadic_additive, False),
    ("C6-opencode-resolver",   cell_c6_opencode_resolver,   True),
]
CELLS_PAID: list[tuple] = [
    ("A1-codex-questions",     cell_a1_codex_questions_differential, True),
    ("A2-opencode-deny-allow", cell_a2_opencode_deny_beats_allow,    True),
    ("A3-claude-deny-allow",   cell_a3_claude_deny_beats_allow,      False),
    ("A5-enabled-arms",        cell_a5_enabled_arms,                 True),
]

ALL_CELLS: list[tuple] = CELLS_FREE + CELLS_PAID
CELL_NAMES_FREE = {c[0] for c in CELLS_FREE}
CELL_NAMES_PAID = {c[0] for c in CELLS_PAID}


def run_cell(
    name: str,
    fn,
    needs_tmp: bool,
    *,
    tmp_dir: str,
    keep: bool,
) -> CellResult:
    result = CellResult(name=name)
    tier = "contract" if name in CELL_NAMES_FREE else "behavioural"

    _log(f"\n{'='*60}")
    _log(f"CELL: {name}  [{tier}]")
    _log(f"{'='*60}")

    cell_tmp = os.path.join(tmp_dir, name.replace("-", "_"))
    os.makedirs(cell_tmp, exist_ok=True)

    try:
        if needs_tmp:
            fn(result, cell_tmp)
        else:
            fn(result)
    except Exception as exc:
        import traceback
        result.fail(f"{type(exc).__name__}: {exc}\n{traceback.format_exc()}")

    _log(f"\n  → {result.verdict}: {name}")
    if result.verdict == FAIL:
        _log(f"     {(result.failure_detail or '')[:300]}")
    elif result.verdict == SKIP:
        _log(f"     SKIP: {result.notes[0][:120] if result.notes else ''}")
    else:
        for note in result.notes[:2]:
            _log(f"     {note[:120]}")
    if result.version_info:
        for k, v in result.version_info.items():
            _log(f"     {k}: {v}")

    # Clean up per-cell tmp dir unless --keep.
    if not keep and not result.verdict == FAIL:
        shutil.rmtree(cell_tmp, ignore_errors=True)

    return result


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

HELP_EPILOG = textwrap.dedent("""
contract cells (Tier 1 — free, no model calls):
  C1-codex-key-exists    tools.experimental_request_user_input accepted + negative control
  C2-codex-value-shape   bare boolean rejected with struct-type error
  C3-codex-last-wins     duplicate -c: last-occurrence-wins proven
  C4-claude-tool-names   EnterPlanMode/ExitPlanMode/AskUserQuestion are known tools
  C5-claude-variadic     --disallowedTools is variadic (space-split) and additive
  C6-opencode-resolver   opencode debug agent: deny is last rule in 6 scenarios

behavioural cells (Tier 2 — real API calls, cost money):
  A1-codex-questions     functions.request_user_input differential x5 repeats
  A2-opencode-deny-allow OPENCODE_CONFIG_CONTENT deny overrides project allow
  A3-claude-deny-allow   --disallowedTools Bash → absent from tool_use records
  A5-enabled-arms        enabled flags observably enable each harness

Approximate Tier-2 cost: ~$0.20–0.40 per run (haiku/mini models).
Tier-1 cost: $0, completes in seconds.
""")


def main(argv: Optional[list[str]] = None) -> int:
    global _json_mode

    parser = argparse.ArgumentParser(
        prog="verify-harness-policy",
        description=(
            "End-to-end verifier for managed-mode capability policy.\n"
            "Tier 1 cells are free (no model calls). Tier 2 cells cost money.\n"
            "Exit non-zero on any FAIL. SKIP is distinct from FAIL."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=HELP_EPILOG,
    )
    parser.add_argument(
        "--only", metavar="CELL[,CELL...]",
        help="Run only the named cell(s), comma-separated",
    )
    parser.add_argument(
        "--harness", metavar="NAME",
        help="Run only cells for this harness (claude|opencode|codex)",
    )
    parser.add_argument(
        "--free-only", action="store_true",
        help="Run only Tier 1 (contract) cells — no model calls, no cost",
    )
    parser.add_argument(
        "--paid-only", action="store_true",
        help="Run only Tier 2 (behavioural) cells — real API calls",
    )
    parser.add_argument(
        "--keep", action="store_true",
        help="Keep temp dirs for debugging (default: clean up on PASS)",
    )
    parser.add_argument(
        "--json", action="store_true",
        help="Emit machine-readable JSON to stdout; human log goes to stderr",
    )
    args = parser.parse_args(argv)
    _json_mode = args.json

    if args.free_only and args.paid_only:
        parser.error("--free-only and --paid-only are mutually exclusive")

    # Determine the candidate cell list.
    all_cell_names = [c[0] for c in ALL_CELLS]
    cells_by_name  = {c[0]: c for c in ALL_CELLS}

    if args.only:
        wanted = [c.strip() for c in args.only.split(",")]
        unknown = [c for c in wanted if c not in cells_by_name]
        if unknown:
            parser.error(f"Unknown cells: {', '.join(unknown)}. Valid: {', '.join(all_cell_names)}")
        cells_to_run = [cells_by_name[c] for c in wanted]
    elif args.harness:
        harness = args.harness.lower()
        cells_to_run = [
            c for c in ALL_CELLS
            if harness in c[0].lower()
        ]
        if not cells_to_run:
            parser.error(f"No cells match --harness {args.harness!r}")
    else:
        cells_to_run = list(ALL_CELLS)

    if args.free_only:
        cells_to_run = [c for c in cells_to_run if c[0] in CELL_NAMES_FREE]
    elif args.paid_only:
        cells_to_run = [c for c in cells_to_run if c[0] in CELL_NAMES_PAID]

    if not cells_to_run:
        _log("No cells selected.")
        return 0

    names_selected = [c[0] for c in cells_to_run]
    _log("verify-harness-policy")
    _log(f"cells: {', '.join(names_selected)}")
    _log(f"keep={args.keep}")
    _log(f"agent_run: {_AR_FILE}")
    _log("")

    # Single shared temp dir for all cells; cells create sub-dirs inside it.
    base_tmp = tempfile.mkdtemp(prefix="vhp-", dir="/var/tmp")
    _log(f"tmp: {base_tmp}")
    _log("")

    try:
        results = [
            run_cell(name, fn, needs_tmp, tmp_dir=base_tmp, keep=args.keep)
            for name, fn, needs_tmp in cells_to_run
        ]
    finally:
        if not args.keep:
            shutil.rmtree(base_tmp, ignore_errors=True)

    pass_count = sum(1 for r in results if r.verdict == PASS)
    fail_count = sum(1 for r in results if r.verdict == FAIL)
    skip_count = sum(1 for r in results if r.verdict == SKIP)

    _log(f"\n{'='*60}")
    _log("SUMMARY")
    _log(f"{'='*60}")
    for r in results:
        marker = {PASS: "✓", FAIL: "✗", SKIP: "~"}.get(r.verdict, "?")
        tier   = "[$0]" if r.name in CELL_NAMES_FREE else "[$$]"
        _log(f"  {marker} {r.verdict:4s}  {tier}  {r.name}")
        if r.verdict == FAIL and r.failure_detail:
            _log(f"         {r.failure_detail.splitlines()[0][:100]}")
        for k, v in r.version_info.items():
            _log(f"         {k}: {v}")
    _log(f"\n  PASS={pass_count}  FAIL={fail_count}  SKIP={skip_count}")

    if args.json:
        print(json.dumps({
            "pass": pass_count,
            "fail": fail_count,
            "skip": skip_count,
            "agent_run_file": _AR_FILE,
            "cells": [
                {
                    "name":           r.name,
                    "tier":           "contract" if r.name in CELL_NAMES_FREE else "behavioural",
                    "verdict":        r.verdict,
                    "failure_detail": r.failure_detail,
                    "notes":          r.notes,
                    "version_info":   r.version_info,
                }
                for r in results
            ],
        }, indent=2))

    return 1 if fail_count > 0 else 0


if __name__ == "__main__":
    sys.exit(main())
